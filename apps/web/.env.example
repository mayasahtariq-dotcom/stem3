# Copy to .env.local. Only NEXT_PUBLIC_ values reach the browser; never put secrets here.
# FastAPI backend base URL (no trailing slash), e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
# Supabase project (phone OTP login). The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web push (Phase 6)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Sentry error reporting; leave empty to disable
NEXT_PUBLIC_SENTRY_DSN=
# true: fake login and MSW fake backend, no keys needed
NEXT_PUBLIC_USE_FAKES=true
#
# Real Aaroh backend (see docs/FRONTEND_PROMPT.md): leave the Supabase values empty and set
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/web
#   NEXT_PUBLIC_USE_FAKES=false
# Login then uses the backend's own phone OTP (demo: teacher 6000000099 / code 123456, class key BI07-AARH).
